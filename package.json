{
  "name": "reel-engine-ai",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "server": "node index.js",
    "start": "node index.js",
    "codespace": "npm ci && npm run build && node scripts/codespace-start.mjs --restart",
    "codespace:check": "node scripts/codespace-start.mjs --check",
    "test": "node --test tests/*.test.js",
    "test:render": "node --test tests/render.integration.js",
    "dev:client": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.49.0",
    "express": "5.2.1",
    "dotenv": "17.3.1",
    "openai": "7.25.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
